# Calibrated IN718 single-track model, NIST AM Bench AMB2022-03 (phase 1, melt-pool scale). 2026-10-26.
# Read by run/run_case.sh; every value can be overridden from the environment (e.g. ABSORP=0.7 run/run_case.sh 0 out).
#
# Heat source: Goldak double ellipsoid, a = b = sqrt(6) sigma from the measured spot (D4sigma), depth semi-axis per case
#   c = C0 * (X / X_0)^N_EXP,  X = P / sqrt(v * D4sigma^3)  (normalised-enthalpy scaling; X_0 = case 0)
# calibrated on depth and width of all 7 cases (h = 20 um): results/calib_multi_h20 it1, RMS error 8.2 %.
ABSORP=0.748695          # laser absorptivity eta
C0=0.182604              # Goldak depth c of case 0 [mm]
N_EXP=0.98581            # exponent n of the depth scaling
# Two-stage liquid fraction: FL_EUT of the latent heat released between T_EUT and the solidus (1260 C), the rest between
# solidus and liquidus (1336 C); calibrated on the solid cooling rate of case 0 (h = 20 um, dt = 5 us): +1.3 %.
FL_EUT=0.23
T_EUT=1423.15            # [K] = 1150 C
# Converged discretisation (results/conv2): element size in the fine box [mm], time step [s]
H_MESH=0.02
DT=5e-6
# Track: laser from X0 to X1 [mm] along +x at y = 0 (steady state at the probe x = 0 from X0 + 0.5 mm), then TAIL [s] of cooling
X0=-0.6
X1=1.5
TAIL=4e-4
